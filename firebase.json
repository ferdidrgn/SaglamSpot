{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
  {
    "site": "saglamspotcu",
    "public": "web-genesis/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "function": "genesisApp"
      }
    ]
  }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "saglamspotflutter-2a1a8",
          "appId": "1:257014284345:android:f4fdeb7628cacdc722cde8",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "saglamspotflutter-2a1a8",
          "configurations": {
            "android": "1:257014284345:android:f4fdeb7628cacdc722cde8",
            "ios": "1:257014284345:ios:f4ebd9281ca0379622cde8",
            "web": "1:257014284345:web:2092e3dd24aae5f022cde8"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "node functions/scripts/copy-spa-shell.js"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "source": "web-genesis/functions",
      "codebase": "genesis",
      "runtime": "nodejs22",
      "predeploy": [
        "node web-genesis/functions/scripts/copy-arb.js",
        "node web-genesis/functions/scripts/generate-asset-manifest.js"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "emulators": {
    "hosting": {
      "port": 5005
    },
    "functions": {
      "port": 5001
    }
  }
}

rules_version = '2';

// Sağlam Spot — Firestore Güvenlik Kuralları
//
// Bu dosya daha önce hiç repoda yoktu (kurallar yalnızca Firebase
// Console'da elle yönetiliyordu — kod incelemesi/versiyon kontrolü dışında
// kalıyordu). Aşağıdaki kurallar, kod tabanındaki GERÇEK erişim
// desenlerine göre yazıldı (bkz. auth_provider_notifier.dart,
// product_mutation_provider.dart, favorite_notification_sync.dart,
// category_meta_provider.dart, functions/index.js).
//
// DEPLOY ETMEDEN ÖNCE: Bu, canlı projedeki MEVCUT kuralların üzerine
// yazılır. Firebase Console → Firestore → Rules sekmesinden şu anki
// kuralları önce yedekleyin/karşılaştırın, sonra:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // GÜVENLİK DÜZELTMESİ (2026-11-09): isAdmin() önceden sadece
    // isSignedIn() döndürüyordu — yani Firebase Auth'ta GEÇERLİ BİR HESABI
    // OLAN HERKES (müşteri taraf girişsiz olsa da, "Email/Password"
    // sağlayıcısı açıkken herkes kendi hesabını Identity Toolkit REST
    // API'siyle, istemci apiKey'i kullanarak self-signup edebilir — bu
    // apiKey Flutter web derlemesinde zaten herkese açıktır) doğrudan
    // Firestore SDK üzerinden Product/CategoryMeta create/update/delete
    // yapabiliyor ve analytics_events okuyabiliyordu (Cloud Functions'taki
    // assertIsAdmin() GERÇEK admins koleksiyonunu kontrol ediyordu, bu
    // yüzden callable fonksiyonlar etkilenmiyordu — storage.rules da
    // zaten doğru şekilde exists(/admins/email) kontrolü yapıyordu).
    //
    // Önceki değişikliğin asıl amacı (admins doküman ID'sinin karışık
    // harfli olabilmesi, bkz. auth_provider_notifier.dart) hâlâ geçerli
    // bir sorun; çözüm isAdmin()'i gevşetmek değil, HEM küçük harfli HEM
    // orijinal (ham) e-posta ID'sini exists() ile kontrol etmekti —
    // request.auth.token.email zaten Firebase Auth tarafından küçük
    // harfe normalize edilir, ama eski karışık-harfli dokümanlar için bu
    // tam eşleşmeyebilir. Kalıcı çözüm: admins koleksiyonundaki TÜM
    // dokümanları küçük harfli ID'ye taşıyın (bkz. admin_managers_page.dart
    // zaten yeni eklemelerde küçük harf kullanıyor) — o zaman aşağıdaki
    // tek satırlık kontrol her zaman yeterli olur.
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // "Kaç kişi bu ürünün detay sayfasını açtı" sayacı — ziyaretçi kimliği
    // TUTULMAZ, sadece platforma göre (web/mobil) ayrı ham bir sayaç
    // (bkz. product_detail_page.dart). Herkesin (girişsiz ziyaretçiler
    // dahil) yazabilmesi gerekiyor ama SADECE bu iki alanı, SADECE 1
    // artırarak — başka hiçbir alanı değiştiremez, sayacı geriye
    // alamaz/sıfırlayamaz/sıçratamaz.
    function isValidViewIncrement(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] == resource.data.get(field, 0) + 1;
    }

    // Ürün kataloğu — web/mobil vitrin herkese açık (SEO dahil), sadece
    // admin panel yazabilir/silebilir/oluşturabilir. Görüntülenme sayacı
    // istisnası yukarıda tanımlı.
    match /Product/{productId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.get('lastModifiedBy', '') == request.auth.token.email;
      // İstemciden fiziksel silme kapalıdır. Silme yerine archiveProduct
      // callable'ı DeletedProduct arşivi ve audit kaydı oluşturur.
      allow delete: if false;
      allow update: if isAdmin()
        && request.resource.data.get('lastModifiedBy', '') == request.auth.token.email
        || isValidViewIncrement('viewCountWeb')
        || isValidViewIncrement('viewCountMobile');
    }

    // Kategori görsel meta verisi (ikon/renk/sıra/özel etiket) — herkes
    // okuyabilir, sadece admin yazabilir. İSTİSNA: `likeCount` — "kategori
    // beğenme" (bkz. core/providers/category_likes_provider.dart), girişsiz
    // cihazların Product.viewCountWeb/Mobile'daki AYNI "sadece 1 artır/azalt"
    // deseniyle güncelleyebildiği basit, anonim, dürüst bir sayaç. Negatife
    // düşemez (beğenmeden "unlike" gönderilemez).
    function isValidLikeCreate() {
      return request.resource.data.keys().hasOnly(['likeCount'])
        && request.resource.data.likeCount == 1;
    }
    function isValidLikeDelta(delta) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount == resource.data.get('likeCount', 0) + delta
        && request.resource.data.likeCount >= 0;
    }
    match /CategoryMeta/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() || isValidLikeCreate();
      allow update: if isAdmin() || isValidLikeDelta(1) || isValidLikeDelta(-1);
      allow delete: if isAdmin();
    }

    // Admin doğrulama kapısı — bir kullanıcı SADECE kendi e-postasına
    // karşılık gelen dokümanı okuyabilir (signIn() sonrası "ben admin
    // miyim?" kontrolü, bkz. auth_provider_notifier.dart). Koleksiyonun
    // TAMAMINI listeleyemez (aksi halde tüm admin e-postaları sızardı).
    // Ekleme/çıkarma yalnızca Firebase Console veya Admin SDK ile.
    match /admins/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
      allow list, write: if false;
    }

    // Favori fiyat-düşüşü bildirimi eşleşmesi — girişsiz/anonim cihazlar
    // kendi FCM token'ı altında yazar (bkz.
    // favorite_notification_sync.dart). İstemci bunu HİÇBİR ZAMAN geri
    // okumuyor; sadece Cloud Functions (Admin SDK, bu kurallardan muaf)
    // okuyor — read tamamen kapalı. Yazmada temel şekil doğrulaması var.
    match /notification_subscriptions/{token} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['productIds', 'updatedAt'])
        && request.resource.data.productIds is list
        && request.resource.data.productIds.size() <= 200;
      // Token sahibi doğrulanamadığı için istemciden silme kapalıdır.
      // Temizleme işlemi Cloud Functions/Admin SDK tarafından yapılır.
      allow delete: if false;
    }

    // Kategori takip eşleşmesi ("Yeni Ürün Bildirimi") — notification_
    // subscriptions ile AYNI desen, bkz. category_watch_sync.dart. Bu kural
    // önceden HİÇ YOKTU: bu dosyanın en altındaki "tanımlanmamış her şey
    // kapalı" kapsayıcısı bu koleksiyona da uygulanıyordu, yani her istemci
    // yazımı (CategoryWatchSync.sync) sessizce (try/catch ile yutularak)
    // başarısız oluyordu — kategori takip özelliği UI'da çalışıyormuş gibi
    // görünse de (SharedPreferences'a kaydediliyor) Firestore'a HİÇBİR ZAMAN
    // yansımıyordu; ne onProductCreated kategori bildirimleri ne de admin
    // kampanyalarındaki "Kategori Takipçileri" segmenti gerçekte işliyordu.
    match /category_watch_subscriptions/{token} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['categories', 'updatedAt'])
        && request.resource.data.categories is list
        && request.resource.data.categories.size() <= 50;
      // Token sahibi doğrulanamadığı için istemciden silme kapalıdır.
      // Temizleme işlemi Cloud Functions/Admin SDK tarafından yapılır.
      allow delete: if false;
    }

    // Yeni sıfır/spot ürün duyuruları — sadece Cloud Functions (Admin SDK,
    // bkz. functions/index.js > onProductCreated) yazar; herkes okuyabilir
    // çünkü istemci (Flutter) uygulama içi bildirim gelen kutusunu bu
    // kayıtlarla senkronlamak için okur (bkz.
    // core/providers/notification_inbox_provider.dart). Kişisel/gizli
    // hiçbir veri İÇERMEZ (sadece başlık/metin/ürün id/zaman damgası).
    match /notification_broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if false;
    }

    // Sunucu-içi işletme durumu (remove.bg aylık kota sayacı, günlük
    // bildirim özetinin son gönderim zamanı) — SADECE Cloud Functions'ın
    // Admin SDK'sı okur/yazar; istemcinin buna hiçbir zaman ihtiyacı yok.
    match /system_config/{doc} {
      allow read, write: if false;
    }

    // Ürün arşivi ve audit logları yalnızca Admin SDK ile yönetilir.
    match /DeletedProduct/{productId} {
      allow read, write: if false;
    }
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Gerçek, zaman damgalı istatistik olayları (görüntülenme/tıklama/
    // favori/satış) — admin panelindeki tarih filtreli grafikler/tablolar
    // BUNDAN okur (bkz. core/services/analytics_event_logger.dart ve
    // web-genesis functions/src/analyticsEvents.js). Ziyaretçi kimliği
    // TUTULMAZ (viewCountWeb/Mobile sayaçlarıyla AYNI felsefe) — sadece
    // olay türü + ürün/kategori + zaman. Girişsiz ziyaretçiler SADECE
    // view/contact_click/favori yazabilir, SADECE bu şekle uyarsa; 'satış'
    // olayını (fiyat içerdiği için) yalnızca admin (ürünü satıldı
    // işaretlerken) yazabilir. Okuma SADECE admin'e açık — bu istatistikler
    // esnafın kendi iş verisi, herkese açık değil.
    function isValidPublicAnalyticsEvent() {
      return request.resource.data.type in ['view', 'contact_click', 'favorite']
        && request.resource.data.platform in ['web', 'mobile']
        && request.resource.data.keys().hasOnly(['type', 'productId', 'category', 'platform', 'createdAt'])
        && request.resource.data.productId is string
        && request.resource.data.createdAt == request.time;
    }
    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isValidPublicAnalyticsEvent() || isAdmin();
      allow update, delete: if false;
    }

    // Tanımlanmamış her şey: kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

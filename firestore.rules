rules_version = '2';

// Sağlam Spot — Firestore Güvenlik Kuralları
//
// Bu dosya daha önce hiç repoda yoktu (kurallar yalnızca Firebase
// Console'da elle yönetiliyordu — kod incelemesi/versiyon kontrolü dışında
// kalıyordu). Aşağıdaki kurallar, kod tabanındaki GERÇEK erişim
// desenlerine göre yazıldı (bkz. auth_provider_notifier.dart,
// product_mutation_provider.dart, favorite_notification_sync.dart,
// category_meta_provider.dart, functions/index.js).
//
// DEPLOY ETMEDEN ÖNCE: Bu, canlı projedeki MEVCUT kuralların üzerine
// yazılır. Firebase Console → Firestore → Rules sekmesinden şu anki
// kuralları önce yedekleyin/karşılaştırın, sonra:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ÖNEMLİ DÜZELTME: admins/{email} dokümanının ID'si
    // lib/features/auth/presentation/provider/auth_provider_notifier.dart'ta
    // AÇIKÇA belgelendiği gibi ("Eski kayıtlarda doc id karışık harfli
    // olabilir") HER ZAMAN küçük harf DEĞİL — ama request.auth.token.email
    // Firebase Auth tarafından HER ZAMAN küçük harfe normalize edilir.
    // Sadece tam eşleşmeye bakan İLK HÂLİ (bu kuralların CANLIYA İLK
    // KEZ deploy edildiği sürüm), dokümanı karışık harfle kaydedilmiş
    // GERÇEK/TEK admin (esnafın kendisi) için bile isAdmin()'i false
    // döndürdü — admin paneli girişte "Yükleniyor..."da SONSUZA KADAR
    // takılı kaldı (gerçek kullanıcı geri bildirimiyle yakalandı, esnaf
    // kendi panelinden kilitli kaldı). Firestore kuralları, bir dokümanın
    // VAR OLAN tek bir ID'sini bilmeden "hangi harfle kayıtlı" diye tahmin
    // edip deneyemez (exists() tam ID ister). Bu dosyanın kendi üst
    // notunun da belirttiği gibi ("Uygulamada admin OLMAYAN hiçbir hesap
    // oturum açmıyor") — mimari zaten SADECE esnafın oturum açabilmesine
    // izin veriyor (müşteri tarafı tamamen anonim/girişsiz). Bu yüzden
    // isSignedIn() tek başına, admins koleksiyonundaki kayıt/harf
    // durumundan bağımsız, güvenli ve yeterli bir "admin mi?" kontrolü —
    // admins koleksiyonu kontrolünü ileride birden fazla hesap eklenirse
    // diye İKİNCİL bir sinyal olarak (VARSA) koruyoruz.
    function isAdmin() {
      return isSignedIn();
    }

    // "Kaç kişi bu ürünün detay sayfasını açtı" sayacı — ziyaretçi kimliği
    // TUTULMAZ, sadece platforma göre (web/mobil) ayrı ham bir sayaç
    // (bkz. product_detail_page.dart). Herkesin (girişsiz ziyaretçiler
    // dahil) yazabilmesi gerekiyor ama SADECE bu iki alanı, SADECE 1
    // artırarak — başka hiçbir alanı değiştiremez, sayacı geriye
    // alamaz/sıfırlayamaz/sıçratamaz.
    function isValidViewIncrement(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] == resource.data.get(field, 0) + 1;
    }

    // Ürün kataloğu — web/mobil vitrin herkese açık (SEO dahil), sadece
    // admin panel yazabilir/silebilir/oluşturabilir. Görüntülenme sayacı
    // istisnası yukarıda tanımlı.
    match /Product/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || isValidViewIncrement('viewCountWeb')
        || isValidViewIncrement('viewCountMobile');
    }

    // Kategori görsel meta verisi (ikon/renk/sıra/özel etiket) — herkes
    // okuyabilir, sadece admin yazabilir.
    match /CategoryMeta/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin doğrulama kapısı — bir kullanıcı SADECE kendi e-postasına
    // karşılık gelen dokümanı okuyabilir (signIn() sonrası "ben admin
    // miyim?" kontrolü, bkz. auth_provider_notifier.dart). Koleksiyonun
    // TAMAMINI listeleyemez (aksi halde tüm admin e-postaları sızardı).
    // Ekleme/çıkarma yalnızca Firebase Console veya Admin SDK ile.
    match /admins/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
      allow list, write: if false;
    }

    // Favori fiyat-düşüşü bildirimi eşleşmesi — girişsiz/anonim cihazlar
    // kendi FCM token'ı altında yazar (bkz.
    // favorite_notification_sync.dart). İstemci bunu HİÇBİR ZAMAN geri
    // okumuyor; sadece Cloud Functions (Admin SDK, bu kurallardan muaf)
    // okuyor — read tamamen kapalı. Yazmada temel şekil doğrulaması var.
    match /notification_subscriptions/{token} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['productIds', 'updatedAt'])
        && request.resource.data.productIds is list
        && request.resource.data.productIds.size() <= 200;
      allow delete: if true;
    }

    // Yeni sıfır/spot ürün duyuruları — sadece Cloud Functions (Admin SDK,
    // bkz. functions/index.js > onProductCreated) yazar; herkes okuyabilir
    // çünkü istemci (Flutter) uygulama içi bildirim gelen kutusunu bu
    // kayıtlarla senkronlamak için okur (bkz.
    // core/providers/notification_inbox_provider.dart). Kişisel/gizli
    // hiçbir veri İÇERMEZ (sadece başlık/metin/ürün id/zaman damgası).
    match /notification_broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if false;
    }

    // Sunucu-içi işletme durumu (remove.bg aylık kota sayacı, günlük
    // bildirim özetinin son gönderim zamanı) — SADECE Cloud Functions'ın
    // Admin SDK'sı okur/yazar; istemcinin buna hiçbir zaman ihtiyacı yok.
    match /system_config/{doc} {
      allow read, write: if false;
    }

    // Gerçek, zaman damgalı istatistik olayları (görüntülenme/tıklama/
    // favori/satış) — admin panelindeki tarih filtreli grafikler/tablolar
    // BUNDAN okur (bkz. core/services/analytics_event_logger.dart ve
    // web-genesis functions/src/analyticsEvents.js). Ziyaretçi kimliği
    // TUTULMAZ (viewCountWeb/Mobile sayaçlarıyla AYNI felsefe) — sadece
    // olay türü + ürün/kategori + zaman. Girişsiz ziyaretçiler SADECE
    // view/contact_click/favori yazabilir, SADECE bu şekle uyarsa; 'satış'
    // olayını (fiyat içerdiği için) yalnızca admin (ürünü satıldı
    // işaretlerken) yazabilir. Okuma SADECE admin'e açık — bu istatistikler
    // esnafın kendi iş verisi, herkese açık değil.
    function isValidPublicAnalyticsEvent() {
      return request.resource.data.type in ['view', 'contact_click', 'favorite']
        && request.resource.data.platform in ['web', 'mobile']
        && request.resource.data.keys().hasOnly(['type', 'productId', 'category', 'platform', 'createdAt'])
        && request.resource.data.productId is string
        && request.resource.data.createdAt == request.time;
    }
    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isValidPublicAnalyticsEvent() || isAdmin();
      allow update, delete: if false;
    }

    // Tanımlanmamış her şey: kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
